          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "histogram_quantile(0.50, sum by (le) (rate({__name__=\"http_request_duration_seconds.bucket\", path=\"GET /{$}\"}[5m])))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "p50"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "741620eb-f2f8-52c1-a061-9a5a973c86f5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Render rate (5m)",
            "description": "traffic context: GET / renders per second — pairs with the users gauge for regression triage"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "3"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
