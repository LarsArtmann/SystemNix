{
  "schemaVersion": "v6",
  "name": "systemnix-browser-history",
  "tags": [
    {
      "key": "owner",
      "value": "systemnix"
    }
  ],
  "spec": {
    "display": {
      "name": "Browser History — Renders & Users",
      "description": "Dashboard render latency (p99/p50/mean) + user-count gauge; feeds the render-slow rule and the user-count Gatus check"
    },
    "variables": [],
    "panels": {
      "24457436-7777-5062-8750-c1256f442337": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Users",
            "description": "browser_history_users — baseline 9 (1 real + 8 zombie bring-up dupes until revoked); increase = registration bypass, decrease = rollback"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{count}",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "browser_history_users",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "0421fe06-e1d3-5de9-8b37-4264062d9396": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Render p99",
            "description": "same query as the browser-history-render-slow rule (target 5s; normal authenticated renders 13-19ms, 2026-10-14 measurement)"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "s",
                "decimalPrecision": "3"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "histogram_quantile(0.99, sum by (le) (rate({__name__=\"http_request_duration_seconds.bucket\", path=\"GET /{$}\"}[5m])))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "beaef2ac-2af5-5385-88cb-8100e4fdcb37": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Render mean",
            "description": "mean GET / render duration (sum/count over the scrape window)"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "s",
                "decimalPrecision": "3"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "{__name__=\"http_request_duration_seconds.sum\", path=\"GET /{$}\"} / {__name__=\"http_request_duration_seconds.count\", path=\"GET /{$}\"}",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "b6f91d6e-91fe-5d60-a0c4-2c99a5c6131d": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Render rate",
            "description": "GET / renders per second (5m rate)"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "3"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate({__name__=\"http_request_duration_seconds.count\", path=\"GET /{$}\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "82e962d9-2650-5859-aca8-ad569950917b": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Render p99 (5m)",
            "description": "rule feed: browser-history-render-slow fires above 5s sustained; both historical bursts were IO-storm context (pre-hot-tier), not server regressions"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "s",
                "decimalPrecision": "3"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "histogram_quantile(0.99, sum by (le) (rate({__name__=\"http_request_duration_seconds.bucket\", path=\"GET /{$}\"}[5m])))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "p99"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "0477cdd3-8a61-5df9-9b8a-d59f8e05354f": {
        "kind": "Panel",
