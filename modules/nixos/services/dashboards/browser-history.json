                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate({__name__=\"http_request_duration_seconds.count\", path=\"GET /{$}\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "renders/s"
                  }
                }
              }
            }
          ],
          "links": []
        }
      }
    },
