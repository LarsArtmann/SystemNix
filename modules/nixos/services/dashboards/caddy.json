{
  "schemaVersion": "v6",
  "name": "systemnix-caddy",
  "tags": [
    {
      "key": "owner",
      "value": "systemnix"
    }
  ],
  "spec": {
    "display": {
      "name": "Caddy Reverse Proxy — HTTP Metrics",
      "description": "Per-vHost RED metrics (per_host enabled 2026-10-25); status codes sliced off the histogram families (requests_total carries no code label)"
    },
    "variables": [],
    "panels": {
      "a7809082-d0c2-5023-ae7a-693e36eab193": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests",
            "description": "Edge-wide request rate"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{count}/s",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(caddy_http_requests_total[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "8cd12494-1bbe-5307-9377-93d914cafba8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "4xx",
            "description": "Client-error rate (from the response-duration histogram count — requests_total carries no code label)"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{count}/s",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(caddy_http_request_duration_seconds.count{code=~\"4..\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "421e2795-a29f-576e-b25e-72028bf7b8b0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "5xx",
            "description": "Server-error rate (from the response-duration histogram count — requests_total carries no code label)"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{count}/s",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(caddy_http_request_duration_seconds.count{code=~\"5..\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "90c3ce59-8bf0-5963-85e5-410ab021f767": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "In-Flight",
            "description": "Requests currently being served"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{count}",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(caddy_http_requests_in_flight)",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "29aa83e8-a8bb-5d9e-904c-974eb8c4a880": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Latency (mean) by Host",
            "description": "Mean response duration per vHost (per_host series, 2026-10-25)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "s",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (host) (rate(caddy_http_response_duration_seconds.sum{host!~\"_other\"}[5m])) / sum by (host) (rate(caddy_http_response_duration_seconds.count{host!~\"_other\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{host}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "339314ba-c70d-5bf6-9c11-1b7e1f205809": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request Rate by Host",
            "description": "Requests per second per vHost (was: Requests by Code — requests_total carries no code label, that panel rendered empty)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "{count}/s",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
