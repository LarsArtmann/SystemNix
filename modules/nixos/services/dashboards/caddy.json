          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (host) (rate(caddy_http_requests_total{host!~\"_other\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{host}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "a5b45540-4d03-53a3-8aa1-00188a3c3442": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "5xx by Host",
            "description": "Server-error rate per vHost (histogram count, code label)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "{count}/s",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (host) (rate(caddy_http_request_duration_seconds.count{code=~\"5..\",host!~\"_other\"}[5m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{host}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "5e50cadd-5025-4e5a-9a5e-5025cadd0001": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Top Hosts by 5xx (15m)",
            "description": "Loudest 5xx offenders over a 15m window — catches a flapping backend a flat 5m rate hides"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "{count}/s",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "topk(10, sum by (host) (rate(caddy_http_request_duration_seconds.count{code=~\"5..\",host!~\"_other\"}[15m])))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{host}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      }
