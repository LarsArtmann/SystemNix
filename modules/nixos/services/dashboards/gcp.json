            "description": "summed request latency per service (histogram .sum suffix, microseconds); refine to quantiles after go-live once live label shape is verified"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "microseconds",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
