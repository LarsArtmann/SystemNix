{
  "schemaVersion": "v6",
  "name": "systemnix-gcp",
  "tags": [
    {
      "key": "owner",
      "value": "systemnix"
    }
  ],
  "spec": {
    "display": {
      "name": "GCP Fleet (Cloud Run / Functions / Storage)",
      "description": "Google Cloud Monitoring metrics pulled by the SigNoz collector's googlecloudmonitoring receivers (projects keyed by the Google-Cloud-Inventory reports). Metric names are stored verbatim DOTTED (run.googleapis.com/...): panel queries MUST use the {__name__=\"...\"} selector form, and the receiver is DELTA-only so every counter/latency family is PromQL-blind (engine-verified 2026-11-12) — this dashboard ships only the four gauge families that render. Runbook: docs/services/signoz-gcp-monitoring.md"
    },
    "panels": {
      "5254ff30-0691-5493-b3f2-fc78091435ab": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cloud Run — Active Containers",
            "description": "active container instances per service (gauge, last value per step). The former Requests panel consumed run.googleapis.com/request_count, a DELTA-temporality family: the PromQL engine returns ZERO series for every Delta family (engine-verified 2026-11-12 via v3 query_range), and the receiver is DELTA-only (runbook) — the request-volume/latency/network/billable/execution panels cannot render and were removed (docs/todo/monitoring.md GCP row)."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "req",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max by (service_name) ({__name__=\"run.googleapis.com/container/containers\"})",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "12e6461f-5e39-5d0f-91b2-c72a6b63e7ad": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Functions — Active Instances",
            "description": "active function instances (gauge). Execution-count panels are Delta-temporality and PromQL-blind (engine-verified 2026-11-12) — removed."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max by (function_name) ({__name__=\"cloudfunctions.googleapis.com/function/active_instances\"})",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "3c711ee0-83e8-5b72-abe2-8e3c456088e3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cloud Storage — Bucket Bytes",
            "description": "total bytes per bucket (gauge). Dotted metric names MUST ride the {__name__=...} selector form: bare dotted identifiers fail PromQL parsing outright and the old underscore names match zero series (both live-verified 2026-11-12)."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "bytes",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (bucket_name) ({__name__=\"storage.googleapis.com/storage/v2/total_bytes\"})",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "e970cb1a-819d-55c2-9b57-10b7f26e9df6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cloud Storage — Object Count",
            "description": "total object count per bucket (gauge). Same {__name__=...} selector requirement as the bytes panel."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (bucket_name) ({__name__=\"storage.googleapis.com/storage/v2/total_count\"})",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 2,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/5254ff30-0691-5493-b3f2-fc78091435ab"
              }
            },
            {
              "x": 2,
              "y": 0,
