{
  "schemaVersion": "v6",
  "name": "systemnix-gcp",
  "tags": [
    {
      "key": "owner",
      "value": "systemnix"
    }
  ],
  "spec": {
    "display": {
      "name": "GCP Fleet (Cloud Run / Functions / Storage)",
      "description": "Google Cloud Monitoring metrics pulled by the SigNoz collector's googlecloudmonitoring receivers (projects keyed by the Google-Cloud-Inventory reports). Queries use SigNoz's dot->underscore metric naming and need live verification at go-live (runbook: docs/services/signoz-gcp-monitoring.md)"
    },
    "panels": {
      "5254ff30-0691-5493-b3f2-fc78091435ab": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cloud Run — Requests",
            "description": "per-service request volume (DELTA sum: each sample is the interval delta — read values directly, no rate())"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "req",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (service_name) (run_googleapis_com_request_count)",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "fd8948b4-8d32-53c4-a49d-9104e3d0e8a1": {
        "kind": "Panel",
        "spec": {
