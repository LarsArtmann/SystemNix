      "e5877ef6-3de3-5c2d-8a70-c9deda966eb4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU Usage",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "percent",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
