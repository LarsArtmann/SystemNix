          "links": []
        }
      },
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-bymodel": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests by Model \u00d7 Code",
            "description": "Per-model request rate split by HTTP status \u2014 the 429 lines are upstream billing/rate rejections."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "{req/min}",
                "decimalPrecision": "1"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (model, code) (rate(ai_meter_requests_total[5m])) * 60",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{model}} {{code}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
