          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(ai_meter_cost_usd_total[15m])) * 3600",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-spendtotal": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Spend Since Start",
            "description": "Cumulative estimated USD since the last ai-meter restart (counter resets on restart)."
