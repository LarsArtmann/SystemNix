{
  "schemaVersion": "v6",
  "name": "systemnix-ai-meter",
  "tags": [
    {
      "key": "owner",
      "value": "systemnix"
    }
  ],
  "spec": {
    "display": {
      "name": "AI Meter \u2014 Routed AI Calls",
      "description": "Per-client/model token, cost, latency and status attribution for every AI call routed through ai-meter (:8107). Feeds the AI Upstream Failure Rate rule; built after the 2026-10-17 Z.ai 1113 outage (coding-plan key on the general endpoint) went unobserved for hours."
    },
    "variables": [],
    "panels": {
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-success": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Success Rate (5m)",
            "description": "Share of routed AI calls returning 2xx. Dropped to ~7% during the 2026-10-17 Z.ai 1113 balance outage \u2014 this panel + the failure-rate rule exist to catch that class within minutes."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{percent}",
                "decimalPrecision": "1"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "100 * sum(rate(ai_meter_requests_total{code=\"200\"}[5m])) / clamp_min(sum(rate(ai_meter_requests_total[5m])), 1e-9)",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-reqmin": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests / min",
            "description": "All routed AI calls through ai-meter, 5m rate."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{req/min}",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(ai_meter_requests_total[5m])) * 60",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-errmin": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Non-2xx / min",
            "description": "Failed routed calls (4xx/5xx) per minute, 5m rate. Includes billing rejections (Z.ai 1113 arrives as HTTP 429) and rate limits."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{req/min}",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(ai_meter_requests_total{code!=\"200\"}[5m])) * 60",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-active": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "In-Flight",
            "description": "Requests currently in flight through the proxy."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "{count}",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "ai_meter_active_requests",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "7493eb6b-ef64-51c5-a91c-4856ec90008f-spendh": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Spend Rate",
            "description": "Estimated spend from the per-model cost table, 15m rate annualized to the hour."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
