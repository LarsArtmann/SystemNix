  ],
  "spec": {
    "display": {
      "name": "Telemetry Coverage",
      "description": "SigNoz service registration rail - traces coverage per registry entry, gap budget ratchet, logs pipeline freshness"
    },
    "variables": [],
    "panels": {
      "829a55ae-18cf-505f-8ed7-85babe871ec3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Traces Missing",
            "description": "Enforced services dark (no span within budget). Healthy: 0"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "signoz_traces_missing",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
