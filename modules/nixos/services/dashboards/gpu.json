{
  "schemaVersion": "v6",
  "name": "systemnix-gpu",
  "tags": [
    {
      "key": "owner",
      "value": "systemnix"
    }
  ],
  "spec": {
    "display": {
      "name": "GPU Metrics — AMD Radeon 8060S",
      "description": "AMD GPU VRAM, temperature, utilization"
    },
    "variables": [],
    "panels": {
      "0a21b83c-aaf2-5dde-a9c9-ec0743e45d80": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "VRAM Usage",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "percent",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "(sum(node_amdgpu_mem_info_vram_used_bytes) / sum(node_amdgpu_mem_info_vram_total_bytes)) * 100",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "1ef5fa69-d812-5283-84c4-9dca6a7a6478": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Temperature (hwmon)",
            "description": "amdgpu edge temp via node_exporter hwmon. Renumber-tolerant regex (:cN:00_0 shape) survives the post-crash bus-renumbering class — the 2026-10-10 shift moved this chip c5:00_0 -> c6:00_0 and stranded the old pinned selector at 0 series. ClickHouse's hwmon-derived async metric (Temperature_amdgpu_edge) ceased to exist 2026-10-12 (CH now emits bare Temperature series from thermal zones), so the old two-source overlay is retired. NPU (amdxdna) exposes NO hwmon temp — kernel-side gap, see docs/todo/ai-stack.md"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "node_hwmon_temp_celsius{chip=~\".*:c[0-9a-f]+:00_0\"}",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "4070dc07-ac4e-5bc8-82b3-e4b79f4b2631": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Busy",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "percent",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(node_amdgpu_gpu_busy_percent)",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "5d9e4ce0-b0ad-5203-bb1d-63ea97c2f92a": {
        "kind": "Panel",
        "spec": {
