          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "node_amdgpu_mem_info_vram_used_bytes",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{card}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "ac1b0dde-0a70-5e04-939f-fca8fd7da901": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Temperature",
            "description": "°C across all cards"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(node_hwmon_temp_celsius{chip=~\".*:c[0-9a-f]+:00_0\"})",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      }
    },
