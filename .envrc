# Speed up nix-direnv: replace 258 `nix build --out-link` GC-root calls (~6.4s)
# with instant symlinks for store paths that already exist.
# The devShell profile GC root still uses real nix build (needs store-path resolution).
_nix_add_gcroot() {
  local storepath=$1
  local symlink=$2
  if [[ $storepath == /nix/store/* ]]; then
    ln -sfn "$storepath" "$symlink"
  else
    _nix build --out-link "$symlink" "$storepath"
  fi
}

use flake
watch_file flake.nix
watch_file flake.lock
