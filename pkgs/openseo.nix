{
  lib,
  stdenv,
  fetchFromGitHub,
  fetchPnpmDeps,
  nodejs,
  pnpm,
  pnpmConfigHook,
  autoPatchelfHook,
}:
stdenv.mkDerivation (finalAttrs: {
  pname = "openseo";
  version = "0.1.1";

  src = fetchFromGitHub {
    owner = "every-app";
    repo = "open-seo";
    rev = "v${finalAttrs.version}";
    hash = "sha256-xsb49Au+PCOe13imPWgfch0S0R84hCUUpIaYRiTyqIQ=";
  };

  nativeBuildInputs = [
    nodejs
    pnpm
    pnpmConfigHook
    autoPatchelfHook
  ];

  # SystemNix patch (2026-10-25, owner decision): route the AI chat agents at
  # synthetic.new instead of openrouter.ai. The @openrouter/ai-sdk-provider
  # createOpenRouter accepts baseURL, but upstream never passes one — no env
  # var exists, and synthetic.new's models are NOT on OpenRouter's catalog
  # (verified live 2026-10-25: 467 models, zero synthetic/syn matches). The
  # module env sets OPENROUTER_BASE_URL + OPENROUTER_MODEL; unset = stock
  # OpenRouter behavior (typeof guard keeps the workerd bundle safe even
  # without nodejs_compat). Works for BOTH consumers: SamChatAgent and the
  # onboarding agent both reach createOpenRouter through buildChatAgentModel.
  # synthetic.new is OpenAI-compatible at /openai/v1 (syn:large:text resolves
  # to hf:deepseek-ai/DeepSeek-V4.1-Flash-1017); OPENROUTER-specific request
  # extensions (provider.order/zdr, usage.include) ride along — live-tolerated
  # per docs, re-verify SAM turns post-deploy and drop the module's BASE_URL/
  # MODEL env lines to fall back to a real OpenRouter key.
  postPatch = ''
    substituteInPlace src/server/lib/openrouter.ts \
      --replace-fail 'return createOpenRouter({ apiKey })(modelId ?? DEFAULT_CHAT_AGENT_MODEL, {' \
        'return createOpenRouter({ apiKey, baseURL: (typeof process !== "undefined" && process.env?.OPENROUTER_BASE_URL) || undefined })(modelId ?? DEFAULT_CHAT_AGENT_MODEL, {'
  '';

  # Native libraries needed by node_modules native addons (sharp, libsql, lightningcss, etc.)
  buildInputs = [
    stdenv.cc.cc.lib
  ];

  pnpmDeps = fetchPnpmDeps {
    inherit (finalAttrs) pname version;
    inherit (finalAttrs) src;
    fetcherVersion = 4;
    # 2026-09-19: refreshed for nixpkgs 20260917.e554fab (fetchPnpmDeps output
    # changed with the nixpkgs bump; src/lockfile unchanged at v0.1.1).
    # 2026-10-05: re-measured for the a7868a7 flake-update wave (same class;
    # src/lockfile unchanged).
    hash = "sha256-UvKL0upwjn0hudX+Pnwby2i6gGYclO/spdTv0SGGeGw=";
  };

  # Provide native libraries at build time so vite/wrangler/workerd can load native addons.
  # autoPatchelfHook handles final patching in postFixup (no /build/ references).
  preBuild = ''
    export LD_LIBRARY_PATH="${
      lib.makeLibraryPath [ stdenv.cc.cc.lib ]
    }''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  '';

  buildPhase = ''
    runHook preBuild

    # AUTH_MODE is inlined into the client bundle by vite (via envPrefix).
    # SystemNix always uses local_noauth.
    AUTH_MODE=local_noauth \
    VITE_SHOW_DEVTOOLS=false \
    NODE_OPTIONS=--max-old-space-size=4096 \
    pnpm run build

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out/lib/openseo

    # Copy the entire built project (node_modules + dist + source + config)
    cp -r . $out/lib/openseo/

    # Remove build-time D1/KV state — runtime state goes to StateDirectory.
    # Keep .wrangler/deploy/ (generated by @cloudflare/vite-plugin during vite build);
    # vite preview reads deploy/config.json at startup.
    rm -rf $out/lib/openseo/.wrangler/state

    runHook postInstall
  '';

  meta = {
    description = "OpenSEO — self-hosted SEO suite (keyword research, rank tracking, audits)";
    homepage = "https://github.com/every-app/open-seo";
    license = lib.licenses.mit;
    platforms = lib.platforms.linux;
  };
})
