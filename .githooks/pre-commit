#!/usr/bin/env bash
# Pre-commit hook for NixOS configuration validation
# Only lints staged files — not the entire codebase

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

cd "$(git rev-parse --show-toplevel)"

if [ ! -f "flake.nix" ]; then
    exit 0
fi

# Fast guard: reject tarball-type nixpkgs before running the slower nix flake check.
# The global Nix registry rewrites nixpkgs/nixos-unstable to channels.nixos.org,
# which is often months stale and breaks deploys.
if [ -f "flake.lock" ]; then
    nixpkgs_type=$(nix eval --impure --json --expr 'let lock = builtins.fromJSON (builtins.readFile ./flake.lock); in lock.nodes.nixpkgs.original.type or "unknown"' 2>/dev/null | tr -d '"' || echo "unknown")
    if [ "$nixpkgs_type" != "github" ]; then
        log_error "nixpkgs flake.lock regression: original type is '$nixpkgs_type', expected 'github'."
        log_error "The global Nix registry rewrote nixpkgs to a tarball. Fix flake.lock and retry."
        exit 1
    fi
fi

# Fast guard: reject Gatus pat() patterns with regex-only chars (? or +).
# Gatus pat() uses GLOB, not regex — ? = single-char wildcard, + = literal.
if git diff --cached --name-only --diff-filter=ACM | grep -q 'gatus-config.nix'; then
    if grep -v '^[[:space:]]*#' modules/nixos/services/gatus-config.nix | grep -qE 'pat\(.*[?+]'; then
        log_error "Gatus pat() patterns contain regex-only chars (? or +)."
        log_error "Gatus pat() uses GLOB — ? is single-char wildcard, not optional quantifier."
        exit 1
    fi
fi

# Fast guard: every tracked *.templ needs a tracked *_templ.go sibling.
# Nix builds vendor source without running `templ generate` — an untracked
# generated file breaks the build with `undefined: someFragment`.
if ! templ_out=$(scripts/check-templ-committed.sh 2>&1); then
    echo "$templ_out" >&2
    log_error "Tracked .templ file(s) without committed *_templ.go — commit the generated files."
    exit 1
fi

# Fast guard: moved/deleted markdown files must not leave dangling references.
# The archive-move class (2026-08-18): `git mv docs/status/X.md
# docs/status/archived/` left stale `docs/status/X.md` links in TODO_LIST and
# research docs — the link check belongs IN the move commit, not in a later
# self-review. Frozen snapshots (archived status reports, planning docs) may
# keep old paths.
MOVED_MD=$(git diff --cached --name-status --diff-filter=DR -- '*.md' | awk '/^R/ { print $3 } /^D/ { print $2 }')
if [ -n "$MOVED_MD" ]; then
    dangling=""
    while IFS= read -r old; do
        [ -n "$old" ] || continue
        hits=$(git grep -lF -- "$old" -- '*.md' 2>/dev/null | grep -vE '^(docs/status/archived/|docs/planning/)' || true)
        if [ -n "$hits" ]; then
            dangling="${dangling}${old} still referenced by:\n${hits}\n"
        fi
    done <<< "$MOVED_MD"
    if [ -n "$dangling" ]; then
        log_error "Moved/deleted markdown files are still referenced by live docs:"
        echo -e "$dangling"
        log_error "Update the references in the same commit (frozen snapshots in docs/status/archived/ and docs/planning/ are exempt)."
        exit 1
    fi
fi

# Fast guard: reject commits with "Unknown Author" identity.
# Catches the silent fallback bug where PMA daemon produced 6,400 unattributable
# commits across 145 repos when git config couldn't be resolved.
# GIT_AUTHOR_*/GIT_COMMITTER_* env vars take precedence over git config.
author_name="${GIT_AUTHOR_NAME:-$(git config user.name)}"
author_email="${GIT_AUTHOR_EMAIL:-$(git config user.email)}"
committer_name="${GIT_COMMITTER_NAME:-$author_name}"
if [[ "$author_name" == "Unknown Author" ]] || [[ "$author_name" == "unknown" ]] \
   || [[ "$committer_name" == "Unknown Author" ]] || [[ "$committer_name" == "unknown" ]] \
   || [[ "$author_email" == "unknown@"* ]] || [[ -z "$author_name" ]]; then
    log_error "Commit identity is 'Unknown Author' or empty — refusing to commit."
    log_error "  author: '$author_name' <$author_email>"
    log_error "  committer: '$committer_name'"
    log_error "Fix: set GIT_AUTHOR_NAME/GIT_COMMITTER_NAME or git config user.name/user.email."
    exit 1
fi

STAGED_NIX=$(git diff --cached --name-only --diff-filter=ACM '*.nix')
all_passed=true

# Fast guard: reject GOTOOLCHAIN=auto in .nix files (breaks sandbox purity).
if [ -n "$STAGED_NIX" ]; then
  gotoolchain_violation=$(echo "$STAGED_NIX" | xargs grep -lnE 'GOTOOLCHAIN.*auto' 2>/dev/null | grep -v 'GOTOOLCHAIN.*off' || true)
  if [ -n "$gotoolchain_violation" ]; then
    log_error "GOTOOLCHAIN=auto found in staged .nix files — breaks Nix sandbox purity."
    echo "$STAGED_NIX" | xargs grep -nE 'GOTOOLCHAIN.*auto' 2>/dev/null | grep -v 'GOTOOLCHAIN.*off'
    exit 1
  fi
fi

# Gitleaks — scans the NEXT COMMIT's tree (git index), NOT full history:
# history holds known-leaked blobs pending the filter-repo purge (see AGENTS.md
# "Secret Leak Incident"); blocking on those would wedge every commit incl. the
# auto-commit daemon. CI (secret-history-scan.yml) owns the full-history gate.
# The old block never exited on failure — it was a silent no-op, which is how
# the 2026-06-11 Resend key leak sailed through (rules-less config + no exit).
log_info "Running gitleaks (secret detector) on staged tree..."
GL_STAGED=$(mktemp -d)
git checkout-index --prefix="$GL_STAGED/" -a
if gitleaks detect --no-git --source "$GL_STAGED" --config "$(pwd)/.gitleaks.toml" > /tmp/gitleaks.log 2>&1; then
    log_success "Gitleaks passed! No secrets in staged tree."
else
    log_error "Gitleaks BLOCKED the commit: secret found in staged tree."
    cat /tmp/gitleaks.log
    rm -rf "$GL_STAGED"
    exit 1
fi
rm -rf "$GL_STAGED"

# Trailing whitespace on staged files only
log_info "Removing trailing whitespace..."
git diff --cached --name-only --diff-filter=ACM | while read -r f; do
    if [ -f "$f" ]; then
        /run/current-system/sw/bin/sed -i 's/[[:space:]]*$//' "$f" 2>/dev/null || true
        git add "$f" 2>/dev/null || true
    fi
done
log_success "Trailing whitespace removed."

# Only run Nix linters if staged .nix files exist
if [ -n "$STAGED_NIX" ]; then
    log_info "Running deadnix (dead code detector) on staged files..."
    if echo "$STAGED_NIX" | xargs nix shell nixpkgs#deadnix --command deadnix > /tmp/deadnix.log 2>&1; then
        log_success "Deadnix passed! No dead code found."
    else
        log_error "Deadnix found issues!"
        cat /tmp/deadnix.log
        all_passed=false
    fi

    log_info "Running statix (Nix linter) on staged files..."
    > /tmp/statix.log
    while IFS= read -r f; do
        nix shell nixpkgs#statix --command statix check -o errfmt "$f" 2>&1 \
            | grep -v ':E:0:' >> /tmp/statix.log || true
    done <<< "$STAGED_NIX"
    if [ -s /tmp/statix.log ]; then
        log_error "Statix found issues in staged files!"
        cat /tmp/statix.log
        all_passed=false
    else
        log_success "Statix passed! No antipatterns found."
    fi

    # MUST be the SAME formatter CI arbitrates with (`nix fmt -- --ci` =
    # treefmt-full-flake from the locked inputs). The old `nix shell
    # nixpkgs#alejandra` call was a SECOND formatter with a DIFFERENT style
    # (floating nixpkgs on top): every commit re-broke CI's fmt check with
    # alejandra-shaped output. `--no-update-lock-file` keeps eval from
    # silently re-locking moving-ref inputs (browser-history, CV, ... ride
    # ref=master) on every commit; if the locked formatter cannot be built
    # (stale lock, offline), WARN and skip — CI still gates formatting.
    log_info "Formatting staged .nix files with the repo formatter (treefmt)..."
    case "$(uname -m)" in
        arm64 | aarch64) sys=aarch64-darwin ;;
        *) sys=x86_64-linux ;;
    esac
    if formatter_path="$(nix build ".#formatter.$sys" --no-link --print-out-paths --no-update-lock-file 2>/dev/null)"; then
        echo "$STAGED_NIX" | while read -r f; do
            if [ -f "$f" ]; then
                "$formatter_path/bin/treefmt" "$f" >/dev/null 2>&1 || true
                git add "$f" 2>/dev/null || true
            fi
        done
        log_success "Staged .nix files formatted."
    else
        log_error "Could not build .#formatter.$sys (stale flake.lock or offline?) — skipping Nix formatting; CI gates it."
    fi
else
    log_info "No staged .nix files — skipping Nix linters."
fi

# Shellcheck on staged .sh files
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACM '*.sh')
if [ -n "$STAGED_SH" ]; then
    log_info "Running shellcheck on staged shell scripts..."
    if echo "$STAGED_SH" | xargs nix shell nixpkgs#shellcheck --command shellcheck --severity=warning > /tmp/shellcheck.log 2>&1; then
        log_success "Shellcheck passed! No issues found."
    else
        log_error "Shellcheck found issues!"
        cat /tmp/shellcheck.log
        all_passed=false
    fi
else
    log_info "No staged .sh files — skipping shellcheck."
fi

# Ruff on staged .py files
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM '*.py')
if [ -n "$STAGED_PY" ]; then
    log_info "Running ruff on staged Python scripts..."
    if echo "$STAGED_PY" | xargs nix shell nixpkgs#ruff --command ruff check > /tmp/ruff.log 2>&1; then
        log_success "Ruff passed! No issues found."
    else
        log_error "Ruff found issues!"
        cat /tmp/ruff.log
        all_passed=false
    fi
else
    log_info "No staged .py files — skipping ruff."
fi

# Nix flake check always runs (validates whole config)
log_info "Running Nix flake check..."
if nix flake check > /tmp/nix-check.log 2>&1; then
    log_success "Nix flake check passed!"
else
    log_error "Nix flake check failed!"
    cat /tmp/nix-check.log
    all_passed=false
fi

if [ "$all_passed" = true ]; then
    log_success "🎉 All validation checks passed!"
    echo -e "${GREEN}Ready to commit!${NC}"
    exit 0
else
    log_error "❌ Some validation checks failed. Commit aborted."
    echo -e "${YELLOW}Fix staged files and try again.${NC}"
    exit 1
fi
